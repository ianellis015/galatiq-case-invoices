# Copy to `.env` and fill in the key. Nothing else is required — every other setting
# has a working default in src/galatiq/config.py.
#
#   cp .env.example .env

LLM_PROVIDER=xai
XAI_API_KEY=xai-xxxxxxxx

# Optional overrides, defaulted in config.py and shown here for reference:
#
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-4.5

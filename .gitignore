# Secrets. The only file the system genuinely needs and the only one that must never
# be committed.
.env
.env.*
!.env.example

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

# Test and lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Databases ---------------------------------------------------------------
# Runtime state: the seeded inventory/ledger database and the LangGraph audit store.
# Regenerated by `uv run python -m galatiq.store.seed`, never committed.
var/
*.db
*.db-wal
*.db-shm

# --- Frontend ----------------------------------------------------------------
# web/ has its own .gitignore from create-next-app, which is the authority for that
# folder. These are here so a stray install or build at the repo root cannot slip
# through, and so a second JS folder added later is covered by default.
node_modules/
.next/
out/
.vercel
*.tsbuildinfo
next-env.d.ts

# --- Logs and editors --------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

.DS_Store
.vscode/
.idea/
*.pem
